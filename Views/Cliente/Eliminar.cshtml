@{
    ViewData["Title"] = "Eliminar cliente";
}

@model Cliente

<p>Esta seguro que desea eliminar al cliente "@Model.Nombre"?</p>

<form class="row g-3" asp-controller="Cliente" asp-action="EliminarConfirm">
    <input type="hidden" name="idCli" asp-for="@Model.IdCliente"> @{ /*para que mande el id, poner el name con el mismo nombre del parametro de EliminarConfirm*/}
    
    <div class="col-12">
        <button type="submit" class="btn btn-outline-danger">
            <i class="bi bi-x-square"></i>
            Eliminar
        </button>
    </div>
</form>