@{
    ViewData["Title"] = "Asignar producto a presupuesto";
}

@model ProductoAltaViewModel

<form class="row g-3" asp-controller="Presupuestos" asp-action="AsignarProducto">

    <input type="hidden" name="idPresupuesto" asp-for="@Model.IdPresupuesto" />

    <select class="form-select" aria-label="Default select example" name="idProducto">  
    @foreach(var producto in Model.Productos)
    {
        <option value="@producto.Id">@producto.Descripcion</option>
    }
    </select>

    <div class="col-md-3">
        <label for="cantidad" class="form-label">Cantidad</label>
        <input type="text" name="cantidad" id="cantidad" class="form-control">
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-outline-success">
        <i class="bi bi-plus-square"></i>
            Asignar producto
        </button>
    </div>
</form>