@{
    ViewData["Title"] = "Listado presupuestos";
}

@model List<Presupuesto>

<a asp-action="Crear" class="text-decoration-none">Crear nuevo presupuesto</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Destinatario</th>
            <th scope="col">Fecha de Creación</th>
            <th scope="col"></th>
            <th scope="col"></th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var presupuesto in Model)
        {
            <tr>
                <td>@presupuesto.Id</td>
                <td>@presupuesto.Cliente.Nombre</td>
                <td>@presupuesto.FechaCreacion.ToString("dd/MM/yyyy")</td>
                <td><a asp-action="ListarDetalles" asp-route-id="@presupuesto.Id" class="text-decoration-none">Listar detalles</a></td>
                <td><a asp-action="Eliminar" asp-route-id="@presupuesto.Id" class="text-decoration-none">Eliminar</a></td>
                <td><a asp-action="AsignarProducto" asp-route-id="@presupuesto.Id" class="text-decoration-none">Asignar producto</a></td>
                <td><a asp-action="Modificar" asp-route-id="@presupuesto.Id" class="text-decoration-none">Modificar</a></td>
            </tr>
        }
    </tbody>
</table>
