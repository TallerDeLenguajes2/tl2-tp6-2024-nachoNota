@{
    ViewData["Title"] = "Modificar presupuesto";
}

@model Presupuesto

<form class="row g-3" asp-controller="Presupuestos" asp-action="Modificar">
    <input hidden asp-for="@Model.Id">
    <div class="col-md-3">
        <label asp-for="@Model.Cliente.IdCliente" class="form-label">Id cliente</label>
        <input type="text" class="form-control" asp-for="@Model.Cliente.IdCliente">
    </div>
    <div class="col-md-3">
        <label asp-for="@Model.FechaCreacion" class="form-label">Fecha creacion</label>
        <input type="date" class="form-control" asp-for="@Model.FechaCreacion">
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-success">
        <i class="bi bi-arrow-repeat"></i>
            Actualizar
        </button>
    </div>
</form>