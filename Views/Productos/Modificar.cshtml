@{
    ViewData["Title"] = "Modificar producto";
}

@model ProductoViewModel
@section Scripts{<partial name="_ValidationScriptsPartial"/>}

<form class="row g-3" asp-controller="Productos" asp-action="Modificar">
    <input hidden asp-for="@Model.Id">
    <div class="col-md-3">
        <label asp-for="@Model.Descripcion" class="form-label">Descripcion</label>
        <input type="text" class="form-control" asp-for="@Model.Descripcion">
    </div>
    <div class="col-md-3">
        <label asp-for="@Model.Precio" class="form-label">Precio</label>
        <input type="text" class="form-control" asp-for="@Model.Precio">
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-success">
            <i class="bi bi-arrow-repeat"></i>
            Actualizar
        </button>
    </div>
</form>
