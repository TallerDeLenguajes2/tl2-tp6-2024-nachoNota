@{
    ViewData["Title"] = "Eliminar producto";
}

@model Producto

<p>Esta seguro que desea eliminar "@Model.Descripcion"?</p>

<form class="row g-3" asp-controller="Productos" asp-action="EliminarConfirm">
    <input type="hidden" name="idProd" asp-for="@Model.Id"> @{ /*para que mande el id, poner el name con el mismo nombre del parametro de EliminarConfirm*/}
    
    <div class="col-12">
        <button type="submit" class="btn btn-outline-danger">
            <i class="bi bi-x-square"></i>
            Eliminar
        </button>
    </div>
</form>