@{
    ViewData["Title"] = "Eliminar producto";
}

@model Presupuesto

<p>Esta seguro que desea eliminar el siguiente presupuesto?</p>

<table class="table mt-3">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Destinatario</th>
            <th scope="col">Fecha de Creación</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>@Model.Id</td>
            <td>@Model.Cliente.Nombre</td>
            <td>@Model.FechaCreacion.ToString("dd/MM/yyyy")</td>
        </tr>
    </tbody>
</table>

<form class="row g-3" asp-controller="Presupuestos" asp-action="EliminarConfirm">
    <input type="hidden" name="id" asp-for="@Model.Id"> @{ /*para que mande el id, poner el name con el mismo nombre del parametro de EliminarConfirm*/}
    
    <div class="col-12">
        <button type="submit" class="btn btn-outline-danger">
        <i class="bi bi-x-square"></i>
            Eliminar
        </button>
    </div>
</form>