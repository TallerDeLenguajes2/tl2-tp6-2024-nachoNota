@{
    ViewData["Title"] = "Crear cliente";
}

@model ClienteViewModel
@section Scripts{<partial name="_ValidationScriptsPartial"/>}

<form class="row g-3" asp-controller="Cliente" asp-action="Crear">
    <div class="col-md-3">
        <label asp-for="@Model.Nombre" class="form-label">Nombre</label>
        <input type="text" class="form-control" asp-for="@Model.Nombre">
    </div>
    <div class="col-md-3">
        <label asp-for="@Model.Email" class="form-label">Email</label>
        <input type="text" class="form-control" asp-for="@Model.Email">
    </div>
    <div class="col-md-3">
        <label asp-for="@Model.Telefono" class="form-label">Telefono</label>
        <input type="text" class="form-control" asp-for="@Model.Telefono">
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-primary">
        <i class="bi bi-plus-square"></i>
            Añadir
        </button>
    </div>
</form>