@{
    ViewData["Title"] = "Iniciar sesion";
}

@model UsuarioViewModel

<h2>@ViewData["Title"]</h2>

<main>
    <div class="border rounded p-5" style="width: 400px;">
        <form method="post" asp-action="Login" class="d-flex flex-column justify-content-between" style="gap: 1.8rem;">
            <div>
                <label class="form-label" asp-for="@Model.NombreUsuario">Usuario</label>
                <input type="text" class="form-control" asp-for="@Model.NombreUsuario"/>
            </div>

            <div>
                <label class="form-label" asp-for="@Model.Contrasena">Contraseña</label>
                <input type="password" class="form-control" asp-for="@Model.Contrasena"/>
            </div>

            <div>
                <button type="submit" class="btn btn-primary w-100">Iniciar sesión</button>
            </div>
        </form>

        <p class="mt-3 text-center">
            ¿Todavía no tienes una cuenta? <a href="#">Regístrate</a>
        </p>
    </div>
</main>
