@{
    ViewData["Title"] = "Crear producto";
}

@model Producto

<form class="row g-3" asp-controller="Productos" asp-action="Crear">
    <div class="col-md-3">
        <label asp-for="@Model.Descripcion" class="form-label">Descripcion</label>
        <input type="text" class="form-control" asp-for="@Model.Descripcion">
    </div>
    <div class="col-md-3">
        <label asp-for="@Model.Precio" class="form-label">Precio</label>
        <input type="text" class="form-control" asp-for="@Model.Precio">
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-primary">
        <i class="bi bi-plus-square"></i>
            Añadir
        </button>
    </div>
</form>